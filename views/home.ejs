<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
	
	<!-- this 'viewport' allows for CSS to make view reponsive and change width at different breakpoints -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Knickers Shop Home Page</title>
	
	
	 <!-- this link is for our Bootstrap CSS -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	
	
    <style>
	
	
	/* set background image to cover entire page */
	.bg-image {
	 background-image: url('images/freerange.jpg');
     background-size: cover;
     background-position: center;
	 /* height set to cover the entire viewport */
     height: 100vh; 
	 }
	

  
	/* Have faded background colour behind thumbnail images */
	.faded-background {
	 /* white background with 80% opacity */
     background-color: rgba(0, 0, 0, 0.65); 
	 /* add padding to create space between thumbnails and background */
     padding: 10px; 
	 /* add rounded corners to the background */
     border-radius: 10px; 
     }
  
 
	
	/* space out and align thumbnails */
	.thumbnails {
	 display: flex;
	 flex-wrap: wrap;
	 justify-content: space-between;
	 gap: 5px;
	 }

	
	
	/* adjust the width of each thumbnail link and text, going across page */
	.thumbnails a {
	 text-align: center;
	 /* width of each thumbnail, have 12 across page */
	 flex-basis: calc(8.33%. - 20px); 
	 }



	/* adjust the width of each thumbnail*/
	.thumbnails img {
	 width: 80px;
	 height: auto;
	 }



	/* id to position thumbnails on the bottom of page*/
	#thumb-bottom {
	 position: absolute;
	 /* 10px from the bottom */
     bottom: 10px; 
     left: 0;
	 /* full width */
     width: 100%; 
	 /* centre content horizontally */
     text-align: center; 
     }



	/* display heading with styling */
	.custom-heading {
	 /* display as an inline block */
	 display: inline-block; 
	 /* add padding for spacing */
     padding: 10px; 
	 /* give bottom margin 40px */
     margin-bottom: 40px; 
	 /* white transparency 50% */
     background-color: rgba(255, 255, 255, 0.5);
	 /* add rounded corners */
     border-radius: 10px; 
	 }


	</style>
  </head>
	

	
	<!-- image set to cover whole background -->
	<body class="bg-image">
	
		<!-- container for bootstrap styling set to be responsive -->
		<div class="container-fluid">
		
				<!-- navigation bar set dark and 50% transparency, containing links-->
				<nav class="navbar navbar-expand-sm navbar-dark" style="background-color: rgba(0, 0, 0, 0.5);">
				
					<!-- list of 3 items on nav bar -->
					<ul class="navbar-nav">
					
						<li class="nav-item">
							<!-- link to About Us page via button -->
							<a class="btn btn-primary" href="AboutUs.html">About Us</a>
						</li>
						
						<li class="nav-item">
							<!-- link to Check Out page via button -->
							<a  href="checkout.html" class="btn btn-warning">Checkout</a>
						</li>
						
						<li class="nav-item">
							<!-- link to Membership page via button -->
							<a class="btn btn-success" href="membership.html">Member's Club</a>
					  </li>
					</ul> 
				</nav>
				
				
				<!-- custom heading class with padding, margin and background color  -->
				<div class="custom-heading p-3 mb-5 bg-light">
					<!-- heading dark colour with smaller inline text as subheading -->
					<h3 class="text-dark" style="display: inline;">Welcome to The Bottom Line -</h3>
					<h6 class="text-dark" style="display: inline;"> you're covered!</h6>
				</div>
		
		
				<!-- id for styling individual thumbnails and class for faded background colour -->	
				<div id="thumb-bottom">
					<div class="faded-background m-5">
						<h4 class="text-light">Choose from our Selections:</h4>
						
							<!-- thumbnail class for styling as a whole starts here -->
							<div class="thumbnails">
						
							<!-- thumbnail links here below, routing to ejs template with database data loaded-->
							<a href="/shop?rec=1" class="text-decoration-none text-light">
								<img src="images/classic.png" alt="Classic Briefs" class="img-thumbnail">
									<div>Classic</div>
							</a>
							
							<!-- continued image links to ejs template with request rec=2 for data from database-->
							<a href="/shop?rec=2"class="text-decoration-none text-light">
								<img src="images/french.png" alt="French Knickers" class="img-thumbnail">
									<div>French</div>
							</a>
							
							<!--image link to ejs template requesting corresponding data from corresponding rec=3  -->
							<a href="/shop?rec=3"class="text-decoration-none text-light">
								<img src="images/thong.png" alt="Thongs" class="img-thumbnail">
									<div>Thongs</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=4"class="text-decoration-none text-light">
								<img src="images/boys.png" alt="Boy Shorts" class="img-thumbnail">
									<div>Boy Shorts</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=5"class="text-decoration-none text-light">
								<img src="images/hips.png" alt="Hipsters" class="img-thumbnail">
									<div>Hipsters</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=6"class="text-decoration-none text-light">
								<img src="images/seamless.png" alt="Seamless Panties" class="img-thumbnail">
									<div>Seamless</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=7"class="text-decoration-none text-light">
								<img src="images/cotton.png" alt="Cotton Panties" class="img-thumbnail">
									<div>Cotton</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=8"class="text-decoration-none text-light">
								<img src="images/shapes.png" alt="Shapewear Panties" class="img-thumbnail">
									<div>Shapewear</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=9"class="text-decoration-none text-light">
								<img src="images/granny.png" alt="Granny Knickers" class="img-thumbnail">
									<div>Granny's</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=10"class="text-decoration-none text-light">
								<img src="images/blooms.png" alt="Bloomers" class="img-thumbnail">
									<div>Bloomers</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=11"class="text-decoration-none text-light">
								<img src="images/silks.png" alt="Sensual Silks" class="img-thumbnail">
									<div>Silk</div>
							</a>
							
							<!-- continuing images link to ejs template with specific rec from database -->
							<a href="/shop?rec=12" class="text-decoration-none text-light">
								<img src="images/satin.png" alt="Satin Brief" class="img-thumbnail">
									<div>Satin</div>
							</a>
						</div>
					</div>
				</div>	
		</div>	
	
	
	
	<!-- The 'script' for js bundle accessed via CDN link below--> 
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	
 </body>
</html>