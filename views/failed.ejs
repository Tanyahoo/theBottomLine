<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  
  <!-- this 'viewport' allows for CSS to make view reponsive and change width at different breakpoints -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Members club</title>
  <!-- Bootstrap CSS -->
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  
 <style>
 
 
 
	 /* change the header text color to red */
	 h1 {
      color: red; 
    }
 
 
	  /* style for inside body of page */
	  body {
	  /* image source for background */
      background-image: url('images/daisy.jpg'); 
      background-size: cover;
      background-position: center;
	  /* fixed background to prevent scrolling */
      background-attachment: fixed; 
	  /* set body to 100% of the viewport height */
      height: 100vh; 
      }



	  /* wrapper to contain style for text box */
      .content-wrapper {
	  /* distance from top of page */
	  margin-top: 100px; 
	  /* white background with 80% opacity */
      background-color: rgba(255, 255, 255, 0.8); 
	  /* add padding to create space between text and box */
      padding: 20px; 
	  /* rounded corners to the text box 10 pixels */
      border-radius: 10px; 
     }
	
	
	
  </style>
</head>
<body>
<!-- container set to be responsive -->
  <div class="container-fluid">
	<!-- grid row design-->
    <div class="row">
	  <!-- column medium size 4 for content,  4 either side-->
      <div class="col-md-4 offset-md-4">
		<!-- wrapper for text -->
        <div class="content-wrapper">
          <h1 class="text-center">Login Failed!</h1>
          <p class="text-center">Please check your details and try again...</p>
			<!-- link via button back to login page -->
            <p><a href="./" class="btn btn-primary d-block mx-auto">Back to Login Page</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- Bootstrap JavaScript and jQuery in a bundle via CND -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  
</body>
</html>
